+"""Native Fibo 2.0 editing in Forge's img2img/reference-image workflow."""
+import torch
+from huggingface_guess import model_list
+
+from backend import memory_management
+from backend.args import dynamic_args
+from backend.diffusion_engine.base import ForgeDiffusionEngine, ForgeObjects
+from backend.patcher.clip import CLIP
+from backend.patcher.unet import UnetPatcher
+from backend.patcher.vae import VAE
+from backend.text_processing.fibo2_engine import Fibo2TextProcessingEngine
+
+
+class Fibo2(ForgeDiffusionEngine):
+    matched_guesses = [model_list.Fibo2]
+
+    def __init__(self, estimated_config, huggingface_components):
+        super().__init__(estimated_config, huggingface_components)
+        clip = CLIP(model_dict={"qwen3vl_4b": huggingface_components["text_encoder"]},
+                    tokenizer_dict={"qwen3vl_4b": huggingface_components["tokenizer"]})
+        vae = VAE(model=huggingface_components["vae"], is_flux2=True)
+        unet = UnetPatcher.from_model(model=huggingface_components["transformer"],
+            diffusers_scheduler=None, k_predictor=self._get_predictor(), config=estimated_config)
+        self.text_processing_engine_fibo = Fibo2TextProcessingEngine(
+            clip.cond_stage_model.qwen3vl_4b, clip.tokenizer.qwen3vl_4b)
+        self.forge_objects = ForgeObjects(unet=unet, clip=clip, vae=vae, clipvision=None)
+        self.forge_objects_original = self.forge_objects.shallow_copy()
+        self.forge_objects_after_applying_lora = self.forge_objects.shallow_copy()
+        self.use_shift = True
+
+    @torch.inference_mode()
+    def get_learned_conditioning(self, prompt):
+        images = []
+        if not prompt.is_negative_prompt:
+            references = list(self.ref_latents)
+            if self.ini_latent is not None:
+                references.insert(0, self.ini_latent)
+                self.ini_latent = None
+            images = [image for image, latent in references]
+            dynamic_args.ref_latents = [latent for image, latent in references]
+        memory_management.load_model_gpu(self.forge_objects.clip.patcher)
+        return self.text_processing_engine_fibo(prompt, images=images)
+
+    @torch.inference_mode()
+    def encode_first_stage(self, x):
+        latent = super().encode_first_stage(x)
+        # Keep the exact image used by the VAE for the VL encoder too.
+        reference = (x[:1].movedim(1, -1).mul(0.5).add(0.5).cpu(), latent[:1].detach().cpu())
+        if dynamic_args.is_referencing:
+            self.ref_latents.append(reference)
+        else:
+            self.ini_latent = reference
+        return latent
+
+    def get_prompt_lengths_on_ui(self, prompt):
+        length = len(self.text_processing_engine_fibo.tokenize([prompt])[0])
+        return length, max(999, length)
+
+    def clear_references(self):
+        super().clear_references()
+        self.ini_latent = None
+        dynamic_args.ref_latents.clear()
