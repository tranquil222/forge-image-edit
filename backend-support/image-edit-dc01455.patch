+    @staticmethod
+    def calculate_shift(width: int, height: int) -> float:
+        """Calculate Diffusers' resolution-aware flow shift.
+
+        The Qwen 2.1 VAE downsamples by 16, so 1024 square is 4096 image
+        tokens and evaluates to about 0.69. Values beyond the documented
+        8192-token reference are capped at 0.9.
+        """
+        image_seq_len = math.ceil(width / 16) * math.ceil(height / 16)
+        base_seq_len, max_seq_len = 256, 8192
+        base_shift, max_shift = 0.5, 0.9
+        ratio = (image_seq_len - base_seq_len) / (max_seq_len - base_seq_len)
+        return max(base_shift, min(max_shift, base_shift + ratio * (max_shift - base_shift)))
+
+    def set_shift(self, shift: float, width: int = None, height: int = None):
+        if dynamic_args.qwen21_auto_shift and width and height:
+            shift = self.calculate_shift(width, height)
+            self.last_shift_mode = "Auto (resolution-aware)"
+        else:
+            self.last_shift_mode = "Manual"
+        return super().set_shift(shift, width=width, height=height)
 
