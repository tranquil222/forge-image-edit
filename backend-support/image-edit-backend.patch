--- /dev/null
+++ b/backend/text_processing/qwen21_engine.py
@@ -0,0 +1,165 @@
+# Qwen-Image 2.1 prompt encoder using Qwen3-VL 8B.
+
+import torch
+
+from backend import memory_management
+from backend.args import dynamic_args
+from backend.text_processing import emphasis, parsing
+from modules.shared import opts
+
+
+VISION_BLOCK = "<|vision_start|><|image_pad|><|vision_end|>"
+SYSTEM_PROMPT = "<|im_start|>system\nComprehend and analyze the provided prompt.<|im_end|>\n"
+T2I_TEMPLATE = SYSTEM_PROMPT + "<|im_start|>user\n{}<|im_end|>\n<|im_start|>assistant\n"
+
+
+class PromptChunk:
+    def __init__(self):
+        self.tokens = []
+        self.multipliers = []
+
+
+class QwenImage21TextProcessingEngine:
+    def __init__(self, text_encoder, tokenizer):
+        self.emphasis = emphasis.get_current_option(opts.emphasis)()
+        self.text_encoder = text_encoder
+        self.tokenizer = tokenizer
+        self.max_length = 99999999
+        self.min_length = 1
+        self.id_pad = 151643
+        self.id_template = 151644
+        self.id_image = 151655
+        self.image_slots = []
+
+    def tokenize(self, texts, image_count=0):
+        prompts = []
+        for text in texts:
+            if image_count:
+                refs = " ".join(f"<image{i + 1}>{VISION_BLOCK}" for i in range(image_count))
+                text = f"{refs} {text.strip()}"
+            prompts.append(T2I_TEMPLATE.format(text.strip()))
+        return self.tokenizer(prompts)["input_ids"]
+
+    def tokenize_line(self, line, images=None):
+        images = images or []
+        parsed = parsing.parse_prompt_attention(line, self.emphasis.name)
+        tokenized = self.tokenize([text for text, _ in parsed], len(images))
+        chunk = PromptChunk()
+        for tokens, (_text, weight) in zip(tokenized, parsed):
+            embed_count = 0
+            for token in tokens:
+                if token == self.id_image and embed_count < len(images):
+                    token = {"type": "image", "data": images[embed_count], "original_type": "image"}
+                    embed_count += 1
+                chunk.tokens.append(token)
+                chunk.multipliers.append(weight)
+        return [chunk]
+
+    def __call__(self, texts, images=None):
+        images = images or []
+        self.emphasis = emphasis.EmphasisNone() if images else emphasis.get_current_option(opts.emphasis)()
+        if any(emphasis.uses_emphasis(x) for x in texts):
+            dynamic_args.last_extra_generation_params["Emphasis"] = self.emphasis.name
+
+        result = []
+        self.image_slots = []
+        for line in texts:
+            for chunk in self.tokenize_line(line, images):
+                z, info = self.process_tokens([chunk.tokens], [chunk.multipliers])
+                z, slots = self.strip_template_and_images(z, chunk.tokens, info)
+                self.image_slots = slots
+                result.append(z[0])
+        return result
+
+    def strip_template_and_images(self, out, tokens, embeds_info):
+        im_starts = [i for i, token in enumerate(tokens) if not isinstance(token, dict) and int(token) == self.id_template]
+        source_cut = im_starts[1] if len(im_starts) > 1 else 0
+        expanded_cut = source_cut + sum(
+            entry["size"] - 1 for entry in embeds_info if entry.get("original_index", 0) < source_cut
+        )
+
+        keep = torch.ones(out.shape[1], dtype=torch.bool, device=out.device)
+        keep[:expanded_cut] = False
+        slots = []
+        for entry in embeds_info:
+            if entry.get("type") != "image":
+                continue
+            start, size = entry["index"], entry["size"]
+            slots.append(int(keep[:start].sum().item()))
+            keep[start : start + size] = False
+        return out[:, keep], slots
+
+    def process_embeds(self, batch_tokens):
+        device = memory_management.text_encoder_device()
+        embeds_out, attention_masks, num_tokens = [], [], []
+        all_info = []
+
+        for tokens in batch_tokens:
+            attention_mask, integer_tokens, other_embeds = [], [], []
+            eos = False
+            for index, token in enumerate(tokens):
+                try:
+                    token_id = int(token)
+                    attention_mask.append(0 if eos else 1)
+                    integer_tokens.append(token_id)
+                    if not eos and token_id == self.id_pad:
+                        eos = True
+                except TypeError:
+                    other_embeds.append((index, token))
+
+            token_tensor = torch.tensor([integer_tokens], device=device, dtype=torch.long)
+            token_embeds = self.text_encoder.get_input_embeddings()(token_tensor)
+            offset = 0
+            embeds_info = []
+            for original_index, embed in other_embeds:
+                visual, extra = self.text_encoder.preprocess_embed(embed, device=device)
+                if visual is None:
+                    offset -= 1
+                    continue
+                insert_at = original_index + offset
+                visual = visual.view(1, -1, visual.shape[-1]).to(device=device, dtype=torch.float32)
+                size = visual.shape[1]
+                token_embeds = torch.cat([token_embeds[:, :insert_at], visual, token_embeds[:, insert_at:]], dim=1)
+                attention_mask = attention_mask[:insert_at] + [1] * size + attention_mask[insert_at:]
+                offset += size - 1
+                embeds_info.append(
+                    {
+                        "type": embed.get("type"),
+                        "index": insert_at,
+                        "original_index": original_index,
+                        "size": size,
+                        "extra": extra,
+                    }
+                )
+
+            embeds_out.append(token_embeds)
+            attention_masks.append(attention_mask)
+            num_tokens.append(sum(attention_mask))
+            all_info.extend(embeds_info)
+
+        return (
+            torch.cat(embeds_out),
+            torch.tensor(attention_masks, device=device, dtype=torch.long),
+            num_tokens,
+            all_info,
+        )
+
+    def process_tokens(self, batch_tokens, batch_multipliers):
+        embeds, mask, count, info = self.process_embeds(batch_tokens)
+        if embeds.size(1) == len(batch_multipliers[0]):
+            self.emphasis.tokens = batch_tokens
+            self.emphasis.multipliers = torch.asarray(batch_multipliers).to(embeds)
+            self.emphasis.z = embeds
+            self.emphasis.after_transformers()
+            embeds = self.emphasis.z
+
+        _final, hidden = self.text_encoder(
+            None,
+            embeds=embeds,
+            attention_mask=mask,
+            num_tokens=count,
+            embeds_info=info,
+            intermediate_output=-1,
+            final_layer_norm_intermediate=False,
+        )
+        return hidden, info
