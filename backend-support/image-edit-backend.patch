+++ b/backend/diffusion_engine/fibo2.py
@@ -0,0 +1,62 @@
+"""Native Fibo 2.0 editing in Forge's img2img/reference-image workflow."""
+import torch
+from huggingface_guess import model_list
+
+from backend import memory_management
+from backend.args import dynamic_args
+from backend.diffusion_engine.base import ForgeDiffusionEngine, ForgeObjects
+from backend.patcher.clip import CLIP
+from backend.patcher.unet import UnetPatcher
+from backend.patcher.vae import VAE
+from backend.text_processing.fibo2_engine import Fibo2TextProcessingEngine
+
+
+class Fibo2(ForgeDiffusionEngine):
+    matched_guesses = [model_list.Fibo2]
+
+    def __init__(self, estimated_config, huggingface_components):
+        super().__init__(estimated_config, huggingface_components)
+        clip = CLIP(model_dict={"qwen3vl_4b": huggingface_components["text_encoder"]},
+                    tokenizer_dict={"qwen3vl_4b": huggingface_components["tokenizer"]})
+        vae = VAE(model=huggingface_components["vae"], is_flux2=True)
+        unet = UnetPatcher.from_model(model=huggingface_components["transformer"],
+            diffusers_scheduler=None, k_predictor=self._get_predictor(), config=estimated_config)
+        self.text_processing_engine_fibo = Fibo2TextProcessingEngine(
+            clip.cond_stage_model.qwen3vl_4b, clip.tokenizer.qwen3vl_4b)
+        self.forge_objects = ForgeObjects(unet=unet, clip=clip, vae=vae, clipvision=None)
+        self.forge_objects_original = self.forge_objects.shallow_copy()
+        self.forge_objects_after_applying_lora = self.forge_objects.shallow_copy()
+        self.use_shift = True
+
+    @torch.inference_mode()
+    def get_learned_conditioning(self, prompt):
+        images = []
+        if not prompt.is_negative_prompt:
+            references = list(self.ref_latents)
+            if self.ini_latent is not None:
+                references.insert(0, self.ini_latent)
+                self.ini_latent = None
+            images = [image for image, latent in references]
+            dynamic_args.ref_latents = [latent for image, latent in references]
+        memory_management.load_model_gpu(self.forge_objects.clip.patcher)
+        return self.text_processing_engine_fibo(prompt, images=images)
+
+    @torch.inference_mode()
+    def encode_first_stage(self, x):
+        latent = super().encode_first_stage(x)
+        # Keep the exact image used by the VAE for the VL encoder too.
+        reference = (x[:1].movedim(1, -1).mul(0.5).add(0.5).cpu(), latent[:1].detach().cpu())
+        if dynamic_args.is_referencing:
+            self.ref_latents.append(reference)
+        else:
+            self.ini_latent = reference
+        return latent
+
+    def get_prompt_lengths_on_ui(self, prompt):
+        length = len(self.text_processing_engine_fibo.tokenize([prompt])[0])
+        return length, max(999, length)
+
+    def clear_references(self):
+        super().clear_references()
+        self.ini_latent = None
+        dynamic_args.ref_latents.clear()
diff --git a/backend/diffusion_engine/qwen21.py b/backend/diffusion_engine/qwen21.py
new file mode 100644
index 00000000..00dfb61d
--- /dev/null
+++ b/backend/diffusion_engine/qwen21.py
@@ -0,0 +1,132 @@
+import math
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from modules.prompt_parser import SdConditioning
+
+import torch
+from huggingface_guess import model_list
+
+from backend import memory_management
+from backend.args import dynamic_args
+from backend.diffusion_engine.base import ForgeDiffusionEngine, ForgeObjects
+from backend.patcher.clip import CLIP
+from backend.patcher.unet import UnetPatcher
+from backend.patcher.vae import VAE
+from backend.text_processing.qwen21_engine import QwenImage21TextProcessingEngine
+
+
+class QwenImage21(ForgeDiffusionEngine):
+    matched_guesses = [model_list.QwenImage21]
+
+    def __init__(self, estimated_config, huggingface_components):
+        super().__init__(estimated_config, huggingface_components)
+        clip = CLIP(
+            model_dict={"qwen3vl_8b": huggingface_components["text_encoder"]},
+            tokenizer_dict={"qwen3vl_8b": huggingface_components["tokenizer"]},
+        )
+        vae = VAE(model=huggingface_components["vae"], is_qwen21=True)
+        unet = UnetPatcher.from_model(
+            model=huggingface_components["transformer"],
+            diffusers_scheduler=None,
+            k_predictor=self._get_predictor(),
+            config=estimated_config,
+        )
+        self.text_processing_engine_qwen = QwenImage21TextProcessingEngine(
+            text_encoder=clip.cond_stage_model.qwen3vl_8b,
+            tokenizer=clip.tokenizer.qwen3vl_8b,
+        )
+        self.forge_objects = ForgeObjects(unet=unet, clip=clip, vae=vae, clipvision=None)
+        self.forge_objects_original = self.forge_objects.shallow_copy()
+        self.forge_objects_after_applying_lora = self.forge_objects.shallow_copy()
+        self.use_shift = True
+        self.last_shift_mode = "Auto"
+
+    @staticmethod
+    def calculate_shift(width: int, height: int) -> float:
+        """Calculate Diffusers' resolution-aware flow shift.
+
+        The Qwen 2.1 VAE downsamples by 16, so 1024 square is 4096 image
+        tokens and evaluates to about 0.69. Values beyond the documented
+        8192-token reference are capped at 0.9.
+        """
+        image_seq_len = math.ceil(width / 16) * math.ceil(height / 16)
+        base_seq_len, max_seq_len = 256, 8192
+        base_shift, max_shift = 0.5, 0.9
+        ratio = (image_seq_len - base_seq_len) / (max_seq_len - base_seq_len)
+        return max(base_shift, min(max_shift, base_shift + ratio * (max_shift - base_shift)))
+
+    def set_shift(self, shift: float, width: int = None, height: int = None):
+        if dynamic_args.qwen21_auto_shift and width and height:
+            shift = self.calculate_shift(width, height)
+            self.last_shift_mode = "Auto (resolution-aware)"
+        else:
+            self.last_shift_mode = "Manual"
+        return super().set_shift(shift, width=width, height=height)
+
+    @torch.inference_mode()
+    def get_learned_conditioning(self, prompt: "SdConditioning"):
+        memory_management.load_model_gpu(self.forge_objects.clip.patcher)
+        diffusion_model = self.forge_objects.unet.model.diffusion_model
+        if hasattr(diffusion_model, "reset_prefix_cache"):
+            diffusion_model.reset_prefix_cache(dynamic_args.qwen21_prefix_cache)
+        if not prompt.is_negative_prompt:
+            references = [*self.ref_latents]
+            if self.ini_latent is not None:
+                references.insert(0, self.ini_latent)
+                self.ini_latent = None
+            if dynamic_args.edit and references:
+                return self.get_learned_conditioning_with_image(prompt, references)
+            dynamic_args.ref_latents.clear()
+            dynamic_args.image_slots.clear()
+        return self.text_processing_engine_qwen(prompt)
+
+    @torch.inference_mode()
+    def get_learned_conditioning_with_image(self, prompt, images):
+        vision_images, ref_latents = [], []
+        for image in images:
+            visual, latent = self.encode_vision(image)
+            vision_images.append(visual)
+            ref_latents.append(latent)
+        conditioning = self.text_processing_engine_qwen(prompt, images=vision_images)
+        dynamic_args.ref_latents = ref_latents
+        dynamic_args.image_slots = list(self.text_processing_engine_qwen.image_slots)
+        return conditioning
+
+    @torch.inference_mode()
+    def encode_vision(self, image):
+        samples = image.movedim(-1, 1)
+        total = 768 * 768
+        scale = math.sqrt(total / (samples.shape[-1] * samples.shape[-2]))
+        vision_width = max(16, round(samples.shape[-1] * scale / 16) * 16)
+        vision_height = max(16, round(samples.shape[-2] * scale / 16) * 16)
+        vision = torch.nn.functional.interpolate(samples[:, :3], size=(vision_height, vision_width), mode="area").movedim(1, -1)
+
+        width = max(16, round(samples.shape[-1] / 16) * 16)
+        height = max(16, round(samples.shape[-2] / 16) * 16)
+        vae_image = torch.nn.functional.interpolate(samples[:, :3], size=(height, width), mode="area").movedim(1, -1)
+        latent = self.forge_objects.vae.encode(vae_image)
+        latent = self.forge_objects.vae.first_stage_model.process_in(latent)
+        return vision, latent
+
+    @torch.inference_mode()
+    def get_prompt_lengths_on_ui(self, prompt):
+        token_count = len(self.text_processing_engine_qwen.tokenize([prompt])[0])
+        return token_count, max(999, token_count)
+
+    @torch.inference_mode()
+    def encode_first_stage(self, x):
+        if dynamic_args.edit:
+            start_image = x[0].movedim(0, -1).mul(0.5).add(0.5).unsqueeze(0)
+            if dynamic_args.is_referencing:
+                self.ref_latents.append(start_image.cpu())
+            else:
+                self.ini_latent = start_image.cpu()
+        return super().encode_first_stage(x)
+
+    def clear_references(self):
+        super().clear_references()
+        self.ini_latent = None
+        diffusion_model = self.forge_objects.unet.model.diffusion_model
+        if hasattr(diffusion_model, "reset_prefix_cache"):
+            diffusion_model.reset_prefix_cache(dynamic_args.qwen21_prefix_cache)
