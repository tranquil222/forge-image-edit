@@ -0,0 +1,404 @@
+# Qwen-Image 2.1 transformer support.
+# Architecture adapted from the Apache-2.0 Diffusers implementation and
+# ComfyUI's day-one integration.
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+
+from backend.attention import attention_function
+from backend.args import dynamic_args
+from backend.nn.flux import EmbedND, timestep_embedding
+
+
+def apply_rotary_emb(x: torch.Tensor, freqs_cis: torch.Tensor) -> torch.Tensor:
+    if x.shape[1] == 0:
+        return x
+    paired = x.reshape(*x.shape[:-1], -1, 1, 2)
+    out = freqs_cis[..., 0] * paired[..., 0] + freqs_cis[..., 1] * paired[..., 1]
+    return out.reshape_as(x)
+
+
+class ZeroCenteredRMSNorm(nn.Module):
+    """RMSNorm whose checkpoint stores (scale - 1)."""
+
+    def __init__(self, dim: int, eps: float = 1e-6):
+        super().__init__()
+        self.weight = nn.Parameter(torch.empty(dim))
+        self.eps = eps
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        weight = self.weight.float() + 1.0
+        return F.rms_norm(x.float(), (x.shape[-1],), weight, self.eps).to(x.dtype)
+
+
+class TextProjection(nn.Module):
+    def __init__(self, in_dim: int, hidden_size: int, eps: float = 1e-6):
+        super().__init__()
+        # Qwen-Image 2.1 stores (scale - 1) for this RMSNorm.
+        self.text_norm = ZeroCenteredRMSNorm(in_dim, eps=eps)
+        self.in_layer = nn.Linear(in_dim, hidden_size, bias=False)
+        self.out_layer = nn.Linear(hidden_size, hidden_size, bias=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.out_layer(F.gelu(self.in_layer(self.text_norm(x)), approximate="tanh"))
+
+
+class TimestepMLP(nn.Module):
+    def __init__(self, hidden_size: int):
+        super().__init__()
+        self.linear_1 = nn.Linear(256, hidden_size, bias=False)
+        self.linear_2 = nn.Linear(hidden_size, hidden_size, bias=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.linear_2(F.silu(self.linear_1(x)))
+
+
+class TimestepEmbedding(nn.Module):
+    def __init__(self, hidden_size: int):
+        super().__init__()
+        # Preserve the official checkpoint path:
+        # time_text_embed.timestep_embedder.linear_{1,2}.weight
+        self.timestep_embedder = TimestepMLP(hidden_size)
+
+    def forward(self, t: torch.Tensor, dtype: torch.dtype) -> torch.Tensor:
+        x = timestep_embedding(t.float(), 256).to(dtype)
+        return self.timestep_embedder(x)
+
+
+class SwiGLUFeedForward(nn.Module):
+    def __init__(self, dim: int, hidden_dim: int, fused: bool = True):
+        super().__init__()
+        self.fused = fused
+        if fused:
+            self.gate_up = nn.Linear(dim, 2 * hidden_dim, bias=False)
+        else:
+            self.proj = nn.Linear(dim, hidden_dim, bias=False)
+            self.gate_layer = nn.Linear(dim, hidden_dim, bias=False)
+        self.out = nn.Linear(hidden_dim, dim, bias=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        if self.fused:
+            gate, up = self.gate_up(x).chunk(2, dim=-1)
+            return self.out(F.silu(gate) * up)
+        return self.out(F.silu(self.gate_layer(x)) * self.proj(x))
+
+
+class Attention(nn.Module):
+    def __init__(self, dim: int, heads: int, dim_head: int, eps: float = 1e-6):
+        super().__init__()
+        self.heads = heads
+        inner_dim = heads * dim_head
+        self.to_q = nn.Linear(dim, inner_dim, bias=False)
+        self.to_k = nn.Linear(dim, inner_dim, bias=False)
+        self.to_v = nn.Linear(dim, inner_dim, bias=False)
+        self.to_out = nn.ModuleList([nn.Linear(inner_dim, dim, bias=False)])
+        self.norm_q = nn.RMSNorm(dim_head, eps=eps)
+        self.norm_k = nn.RMSNorm(dim_head, eps=eps)
+
+    def project(self, x, pe):
+        batch, tokens, _ = x.shape
+        q = self.norm_q(self.to_q(x).view(batch, tokens, self.heads, -1))
+        k = self.norm_k(self.to_k(x).view(batch, tokens, self.heads, -1))
+        v = self.to_v(x).view(batch, tokens, self.heads, -1)
+        # The rotary table is kept in fp32 for positional accuracy.  Cast the
+        # rotated queries/keys back to the activation dtype before SDPA so Q,
+        # K and V remain compatible on CUDA.
+        q = apply_rotary_emb(q, pe).to(v.dtype).flatten(2)
+        k = apply_rotary_emb(k, pe).to(v.dtype).flatten(2)
+        v = v.flatten(2)
+        return q, k, v
+
+    def attend_segments(self, q, k, v, segments, transformer_options=None):
+        transformer_options = transformer_options or {}
+        outputs = []
+        for start, end, mask in segments:
+            outputs.append(
+                attention_function(
+                    q[:, start:end],
+                    k[:, :end],
+                    v[:, :end],
+                    self.heads,
+                    mask,
+                    transformer_options=transformer_options,
+                )
+            )
+        return self.to_out[0](torch.cat(outputs, dim=1))
+
+    def forward(self, x, pe, segments, transformer_options=None):
+        q, k, v = self.project(x, pe)
+        return self.attend_segments(q, k, v, segments, transformer_options)
+
+    def forward_with_prefix(self, x, pe, prefix_k, prefix_v, transformer_options=None):
+        q, k, v = self.project(x, pe)
+        out = attention_function(
+            q,
+            torch.cat([prefix_k, k], dim=1),
+            torch.cat([prefix_v, v], dim=1),
+            self.heads,
+            None,
+            transformer_options=transformer_options or {},
+        )
+        return self.to_out[0](out)
+
+
+def _split_rows(value: torch.Tensor):
+    # The final row is t=0 for text/reference tokens. Other rows are target t.
+    return value[-1:].unsqueeze(1), value[:-1].unsqueeze(1)
+
+
+def _modulated_norm(norm, x, scale, prefix_len):
+    prefix_scale, target_scale = scale
+    out = norm(x)
+    if prefix_len:
+        return torch.cat(
+            [out[:, :prefix_len] * (1 + prefix_scale), out[:, prefix_len:] * (1 + target_scale)],
+            dim=1,
+        )
+    return out * (1 + target_scale)
+
+
+def _gated_residual(x, y, gate, prefix_len):
+    prefix_gate, target_gate = gate
+    if prefix_len:
+        return torch.cat(
+            [x[:, :prefix_len] + y[:, :prefix_len] * prefix_gate, x[:, prefix_len:] + y[:, prefix_len:] * target_gate],
+            dim=1,
+        )
+    return x + y * target_gate
+
+
+class QwenImage21TransformerBlock(nn.Module):
+    def __init__(self, dim, num_attention_heads, attention_head_dim, mlp_ratio=3, eps=1e-6, fused_mlp=True):
+        super().__init__()
+        self.img_norm1 = nn.LayerNorm(dim, elementwise_affine=False, eps=eps)
+        self.attn = Attention(dim, num_attention_heads, attention_head_dim, eps=eps)
+        self.img_norm2 = nn.LayerNorm(dim, elementwise_affine=False, eps=eps)
+        self.img_mlp = SwiGLUFeedForward(dim, dim * mlp_ratio, fused=fused_mlp)
+
+    def forward(self, x, mod, pe, segments, prefix_len, transformer_options=None):
+        scale1, gate1, scale2, gate2 = mod
+        attn_in = _modulated_norm(self.img_norm1, x, scale1, prefix_len)
+        x = _gated_residual(x, self.attn(attn_in, pe, segments, transformer_options), gate1, prefix_len)
+        mlp_in = _modulated_norm(self.img_norm2, x, scale2, prefix_len)
+        x = _gated_residual(x, self.img_mlp(mlp_in), gate2, prefix_len)
+        if x.dtype == torch.float16:
+            x = x.clip(-65504, 65504)
+        return x
+
+    def forward_prefix_and_cache(self, x, mod, pe, segments, transformer_options=None):
+        scale1, gate1, scale2, gate2 = mod
+        prefix_len = x.shape[1]
+        attn_in = _modulated_norm(self.img_norm1, x, scale1, prefix_len)
+        q, k, v = self.attn.project(attn_in, pe)
+        attn_out = self.attn.attend_segments(q, k, v, segments, transformer_options)
+        x = _gated_residual(x, attn_out, gate1, prefix_len)
+        mlp_in = _modulated_norm(self.img_norm2, x, scale2, prefix_len)
+        x = _gated_residual(x, self.img_mlp(mlp_in), gate2, prefix_len)
+        if x.dtype == torch.float16:
+            x = x.clip(-65504, 65504)
+        return x, k.detach(), v.detach()
+
+    def forward_target_with_prefix(self, x, mod, pe, prefix_k, prefix_v, transformer_options=None):
+        scale1, gate1, scale2, gate2 = mod
+        attn_in = _modulated_norm(self.img_norm1, x, scale1, 0)
+        attn_out = self.attn.forward_with_prefix(attn_in, pe, prefix_k, prefix_v, transformer_options)
+        x = _gated_residual(x, attn_out, gate1, 0)
+        mlp_in = _modulated_norm(self.img_norm2, x, scale2, 0)
+        x = _gated_residual(x, self.img_mlp(mlp_in), gate2, 0)
+        if x.dtype == torch.float16:
+            x = x.clip(-65504, 65504)
+        return x
+
+
+class LastLayer(nn.Module):
+    def __init__(self, dim: int, eps: float = 1e-6):
+        super().__init__()
+        self.linear = nn.Linear(dim, dim, bias=False)
+        self.norm = nn.LayerNorm(dim, eps=eps, elementwise_affine=False)
+
+    def forward(self, x, temb):
+        scale = self.linear(F.silu(temb)).unsqueeze(1)
+        return self.norm(x) * (1 + scale)
+
+
+class QwenImage21Transformer2DModel(nn.Module):
+    def __init__(
+        self,
+        in_channels=64,
+        out_channels=64,
+        num_layers=32,
+        attention_head_dim=128,
+        num_attention_heads=32,
+        context_in_dim=4096,
+        mlp_ratio=3,
+        axes_dims_rope=(16, 56, 56),
+        eps=1e-6,
+        fused_mlp=True,
+        image_model=None,
+        **kwargs,
+    ):
+        super().__init__()
+        self.out_channels = out_channels
+        self.inner_dim = num_attention_heads * attention_head_dim
+        self.pe_embedder = EmbedND(dim=attention_head_dim, theta=10000, axes_dim=list(axes_dims_rope))
+        self.time_text_embed = TimestepEmbedding(self.inner_dim)
+        self.txt_in = TextProjection(context_in_dim, self.inner_dim, eps=eps)
+        self.img_in = nn.Linear(in_channels, self.inner_dim, bias=False)
+        self.modulation = nn.Sequential(nn.SiLU(), nn.Linear(self.inner_dim, 4 * self.inner_dim, bias=False))
+        self.transformer_blocks = nn.ModuleList(
+            [
+                QwenImage21TransformerBlock(
+                    self.inner_dim,
+                    num_attention_heads,
+                    attention_head_dim,
+                    mlp_ratio=mlp_ratio,
+                    eps=eps,
+                    fused_mlp=fused_mlp,
+                )
+                for _ in range(num_layers)
+            ]
+        )
+        self.norm_out = LastLayer(self.inner_dim, eps=eps)
+        self.proj_out = nn.Linear(self.inner_dim, out_channels, bias=False)
+        # K/V for text and reference images are independent of the denoising
+        # timestep. Keep at most two slots (normally positive and negative).
+        self.prefix_cache_enabled = True
+        self.prefix_cache = {}
+        self.prefix_cache_order = []
+        self.prefix_cache_limit_bytes = int(2.5 * 1024**3)
+        self.prefix_cache_hits = 0
+        self.prefix_cache_fills = 0
+        self.prefix_cache_skips = 0
+
+    def reset_prefix_cache(self, enabled=True):
+        self.prefix_cache.clear()
+        self.prefix_cache_order.clear()
+        self.prefix_cache_enabled = bool(enabled)
+        self.prefix_cache_hits = 0
+        self.prefix_cache_fills = 0
+        self.prefix_cache_skips = 0
+
+    @staticmethod
+    def _prefix_cache_key(x, context, ref_latents, image_slots):
+        def tensor_id(t):
+            flat = t.detach().reshape(-1)
+            if flat.numel() == 0:
+                sample = ()
+                checksum = 0.0
+            else:
+                count = min(12, flat.numel())
+                indices = torch.linspace(0, flat.numel() - 1, count, device=flat.device).long()
+                sample = tuple(flat[indices].float().cpu().tolist())
+                checksum = float(flat.float().sum().item())
+            return (tuple(t.shape), str(t.dtype), str(t.device), sample, checksum)
+
+        return (
+            tensor_id(context),
+            tuple(tensor_id(r) for r in ref_latents),
+            tuple(image_slots),
+            tuple(x.shape[-2:]),
+        )
+
+    def _remember_prefix(self, key, values):
+        self.prefix_cache[key] = values
+        self.prefix_cache_order.append(key)
+        while len(self.prefix_cache_order) > 2:
+            old = self.prefix_cache_order.pop(0)
+            self.prefix_cache.pop(old, None)
+
+    def build_sequence(self, x, context, ref_latents, image_slots):
+        txt = self.txt_in(context)
+        slots = (list(image_slots) + [txt.shape[1]] * len(ref_latents))[: len(ref_latents)]
+        bounds = [0] + slots + [txt.shape[1]]
+        parts, ids, segments = [], [], []
+        pos = length = 0
+
+        for (start, end), image in zip(zip(bounds[:-1], bounds[1:]), ref_latents + [x]):
+            count = end - start
+            if count > 0:
+                parts.append(txt[:, start:end])
+                ids.append(torch.arange(pos, pos + count, device=x.device, dtype=torch.float32).unsqueeze(1).expand(count, 3))
+                segments.append(
+                    (
+                        length,
+                        length + count,
+                        torch.ones((count, length + count), dtype=torch.bool, device=x.device).tril(length),
+                    )
+                )
+                pos += count
+                length += count
+
+            height, width = image.shape[-2:]
+            parts.append(self.img_in(image.flatten(2).transpose(1, 2)))
+            yy = torch.arange(height, device=x.device, dtype=torch.float32) - (height - height // 2) + 0.5 * (height % 2 - x.shape[-2] % 2)
+            xx = torch.arange(width, device=x.device, dtype=torch.float32) - (width - width // 2) + 0.5 * (width % 2 - x.shape[-1] % 2)
+            ids.append(
+                torch.stack(
+                    [
+                        torch.full((height, width), pos, device=x.device, dtype=torch.float32),
+                        yy[:, None].expand(height, width),
+                        xx[None, :].expand(height, width),
+                    ],
+                    dim=-1,
+                ).flatten(0, 1)
+            )
+            segments.append((length, length + height * width, None))
+            pos += max(height, width)
+            length += height * width
+
+        pe = self.pe_embedder(torch.cat(ids, dim=0).unsqueeze(0)).transpose(1, 2).contiguous()
+        return torch.cat(parts, dim=1), pe, segments
+
+    def forward(self, x, timesteps, context, ref_latents=None, image_slots=None, transformer_options=None, **kwargs):
+        batch, _channels, height, width = x.shape
+        dtype = x.dtype
+        if ref_latents is None:
+            ref_latents = dynamic_args.ref_latents
+        if image_slots is None:
+            image_slots = dynamic_args.image_slots
+        ref_latents = [r.to(x) for r in ref_latents]
+        hidden_states, pe, segments = self.build_sequence(x, context, ref_latents, image_slots)
+        prefix_len = hidden_states.shape[1] - height * width
+
+        # The reference implementation rounds t at the model compute dtype.
+        t = ((timesteps * 1000).to(dtype) / 1000).to(dtype)
+        temb = self.time_text_embed(torch.cat([t, t.new_zeros(1)]), dtype)
+        scale1, gate1, scale2, gate2 = self.modulation(temb).chunk(4, dim=-1)
+        mod = (_split_rows(scale1), _split_rows(gate1.tanh()), _split_rows(scale2), _split_rows(gate2.tanh()))
+
+        options = transformer_options or {}
+        cache_key = self._prefix_cache_key(x, context, ref_latents, image_slots)
+        cached = self.prefix_cache.get(cache_key) if self.prefix_cache_enabled and prefix_len else None
+        cache_bytes = 2 * len(self.transformer_blocks) * batch * prefix_len * self.inner_dim * hidden_states.element_size()
+        can_fill_cache = self.prefix_cache_enabled and prefix_len and cache_bytes <= self.prefix_cache_limit_bytes
+
+        if cached is not None:
+            self.prefix_cache_hits += 1
+            hidden_states = hidden_states[:, prefix_len:]
+            pe = pe[:, prefix_len:]
+            for block, (prefix_k, prefix_v) in zip(self.transformer_blocks, cached):
+                hidden_states = block.forward_target_with_prefix(hidden_states, mod, pe, prefix_k, prefix_v, options)
+            prefix_len = 0
+        elif can_fill_cache:
+            self.prefix_cache_fills += 1
+            prefix_states = hidden_states[:, :prefix_len]
+            hidden_states = hidden_states[:, prefix_len:]
+            prefix_pe = pe[:, :prefix_len]
+            pe = pe[:, prefix_len:]
+            cache_values = []
+            for block in self.transformer_blocks:
+                prefix_states, prefix_k, prefix_v = block.forward_prefix_and_cache(prefix_states, mod, prefix_pe, segments[:-1], options)
+                cache_values.append((prefix_k, prefix_v))
+                hidden_states = block.forward_target_with_prefix(hidden_states, mod, pe, prefix_k, prefix_v, options)
+            self._remember_prefix(cache_key, cache_values)
+            prefix_len = 0
+        else:
+            if self.prefix_cache_enabled and prefix_len:
+                self.prefix_cache_skips += 1
+            for block in self.transformer_blocks:
+                hidden_states = block(hidden_states, mod, pe, segments, prefix_len, options)
+
+        hidden_states = self.norm_out(hidden_states[:, prefix_len:], temb[:-1])
+        hidden_states = self.proj_out(hidden_states)
+        return hidden_states.transpose(1, 2).reshape(batch, self.out_channels, height, width)
